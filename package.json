{
  "name": "zenith-evm-mcp",
  "version": "0.1.0",
  "description": "MCP server and agent skill for Zenith EVM: chain reads, EVM to Canton tracing, Gateway safety checks, contract verification and guarded testnet writes.",
  "type": "module",
  "bin": {
    "zenith-evm-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:live": "ZENITH_LIVE=1 vitest run test/live --no-file-parallelism --testTimeout=120000",
    "docs": "npm run build && node scripts/gen-tool-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "zenith",
    "canton",
    "evm",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "gateway",
    "solidity",
    "web3"
  ],
  "author": "shedybaba",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shedybaba/zenith-evm-mcp.git"
  },
  "homepage": "https://github.com/shedybaba/zenith-evm-mcp#readme",
  "bugs": {
    "url": "https://github.com/shedybaba/zenith-evm-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "solc": "0.8.39",
    "viem": "2.58.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
